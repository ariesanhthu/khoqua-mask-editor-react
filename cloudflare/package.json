{
  "name": "khoqua-cloudflare-worker",
  "private": true,
  "version": "0.1.0",
  "description": "Cloudflare Worker + Container wrapper that runs annotation-tool (Next.js standalone) on Cloudflare Containers.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-types": "5.20261024.1",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
