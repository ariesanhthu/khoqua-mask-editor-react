{
  "name": "bitter-melon-annotation-workspace",
  "private": true,
  "version": "3.0.0",
  "scripts": {
    "dev": "npm --prefix annotation-tool run dev",
    "build": "npm --prefix annotation-tool run build",
    "start": "npm --prefix annotation-tool run start",
    "lint": "npm --prefix annotation-tool run lint",
    "typecheck": "npm --prefix annotation-tool run typecheck",
    "dataset:convert": "python scripts/convert_v7_prelabels.py",
    "dataset:test": "python -m unittest discover -s scripts -p test_convert_v7_prelabels.py",
    "dataset:upload": "npm --prefix annotation-tool run dataset:upload --",
    "dataset:setup": "npm --prefix annotation-tool run dataset:setup --"
  }
}
